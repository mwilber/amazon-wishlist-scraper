# Paths may be absolute or relative to the project directory.
DATABASE_PATH=data/wishlist-monitor.sqlite
BROWSER_PROFILE_PATH=browser-profile
DIAGNOSTICS_PATH=diagnostics
LOG_PATH=logs/wishlist-monitor.log
LISTS_CONFIG_PATH=config/lists.json

MESSAGE_ENDPOINT_URL=https://example.com/message-endpoint
# MESSAGE_ENDPOINT_TOKEN=replace-with-a-token-if-required
# Generic endpoints receive {"message":"..."}. Use "sid" for SID's
# {"title":"...","body":"...","source":"..."} notification contract.
MESSAGE_ENDPOINT_FORMAT=message
# SID_NOTIFICATION_TITLE=Amazon Wish List Update
# SID_NOTIFICATION_SOURCE=amazon-wishlist-monitor

HEADLESS=true
SCAN_TIMEOUT_MS=45000
MESSAGE_TIMEOUT_MS=10000
MAX_MESSAGE_LENGTH=500
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=60000
